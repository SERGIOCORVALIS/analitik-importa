# Copy to .env and fill values before stages 2–4.
# Do not commit .env

# Temporary stubs for eBay / MPSTATS / Amazon (set false when live keys ready)
USE_API_STUBS=true

# --- Stage 2: eBay Browse API ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_US | EBAY_DE | EBAY_GB
EBAY_MARKETPLACE_ID=EBAY_US

# --- Stage 3: MPSTATS ---
MPSTATS_TOKEN=

# --- Ozon Seller API (seller.ozon.ru -> Настройки -> Seller API) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- Wildberries API (seller.wildberries.ru -> Настройки -> Доступ к API, только чтение:
# Контент, Статистика, Аналитика, Цены и скидки) ---
WB_API_TOKEN=

# --- Склад и закупки (дни) ---
LEAD_TIME_DAYS=45
SAFETY_DAYS=14
COVER_DAYS=60
SALES_WINDOW_DAYS=30

# --- Налог: usn6 | usn15 | npd | osno | none ---
TAX_MODE=usn6
TAX_RATE_PCT=6

# --- Stage 4: Amazon Creators API (Associates) ---
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com

# --- Unit economics defaults (RUB / CNY) ---
CNY_RUB_RATE=12.5
CARGO_PER_KG_RUB=450
DEFAULT_WEIGHT_KG=0.3
COMMISSION_WB_PCT=15
COMMISSION_OZON_PCT=15
COMMISSION_YM_PCT=12
COMMISSION_AVITO_PCT=5
ADS_PCT=8
DEFECT_PCT=3
TARGET_MARGIN_PCT=25
